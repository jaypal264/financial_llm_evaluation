# =============================================================================
# ENVIRONMENT VARIABLES — Financial LLM Evaluation Project
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- Hugging Face ---
# Get your token at: https://huggingface.co/settings/tokens
# Required for gated models (Llama, Gemma, etc.) and HF Inference Providers
HF_TOKEN=hf_your_token_here

# --- OpenAI-compatible API (optional fallback) ---
# If using Together AI, Groq, or any OpenAI-compatible endpoint
TOGETHER_API_KEY=your_together_key_here
GROQ_API_KEY=your_groq_key_here

# --- Inference provider selection ---
# Options: "huggingface", "together", "groq", "local_transformers", "ollama"
INFERENCE_PROVIDER=huggingface

# --- Ollama (if running locally) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Project settings ---
PILOT_MODE=True
MAX_QUESTIONS_PER_DATASET=5
RANDOM_SEED=42
MAX_RETRIES=3
MAX_CONCURRENT_REQUESTS=1

