# =============================================================================
# .gitignore — Financial LLM Evaluation Project
# IIT Guwahati | Big Data Analytics Course Project
# =============================================================================

# --- Environment & Secrets ---
.env
*.env
*.env.*
secrets/
*.pem
*.key

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# --- Virtual Environments ---
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# --- Jupyter Notebooks & Caches ---
.ipynb_checkpoints/
*.ipynb_checkpoints
*/.ipynb_checkpoints/*

# --- Large Raw Datasets (Downloaded via src/data_loader.py) ---
data/raw/*.json
data/raw/*.jsonl
data/raw/*.csv
data/raw/*.parquet
data/raw/*.xlsx
data/raw/*.arrow
data/documents/*.pdf
data/documents/*.txt

# --- Processed Embeddings & FAISS Indices (Generated Locally) ---
data/processed/*.faiss
data/processed/*.pkl
data/processed/faiss_index/

# --- Keep directory structure tracked with .gitkeep ---
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/documents/.gitkeep

# --- Large Results & Checkpoints ---
results/model_responses/*.json
results/model_responses/*.jsonl
results/model_responses/checkpoints/*.json
checkpoints/
*.ckpt
*.pth

# --- Keep results directory structure tracked ---
!results/metrics/.gitkeep
!results/model_responses/.gitkeep
!results/model_responses/checkpoints/.gitkeep
!results/plots/.gitkeep
!results/summary/.gitkeep

# --- Scratch & Temporary Files ---
scratch/
tmp/
temp/

# --- IDE & OS Metadata ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db

# --- Logs & Test Caches ---
*.log
logs/
.pytest_cache/
.coverage
htmlcov/

# --- Cache Directories ---
.cache/
~/.cache/
matplotlib/
